{
  "grammars": [
    {
      "name": "snowflake_sql",
      "camelcase": "SnowflakeSQL",
      "scope": "source.snowflake_sql",
      "path": ".",
      "file-types": [
        "sql",
        "snowsql"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injections": [
        "queries/injections.scm"
      ],
      "indents": [
        "queries/indents.scm"
      ],
      "folds": [
        "queries/folds.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter Grammar for Snowflake SQL",
    "authors": [
      {
        "name": "derek stride"
      },
      {
        "name": "hectron"
      }
    ],
    "links": {
      "repository": "git+https://github.com/hectron/tree-sitter-snowflake-sql.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
